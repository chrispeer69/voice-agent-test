SAFE_TEST_MODE=true
APP_ACCESS_PASSWORD=
SESSION_SECRET=
# Live GHL credentials for the planner; SAFE_TEST_MODE applies only to Emily.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
# IANA timezone from GHL subaccount Settings, e.g. America/New_York.
GHL_TIMEZONE=
CONVINI_AGENT_ID=
USTOW_AGENT_ID=

# Railway: reference the PostgreSQL service as ${{Postgres.DATABASE_URL}}.
# Leave blank locally to use SQLite in PLANNER_DATA_DIR.
DATABASE_URL=
PLANNER_DATA_DIR=.data
